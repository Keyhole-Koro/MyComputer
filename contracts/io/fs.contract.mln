package fs_types;
import { Describe } from "@std/core/describe.mln";

// Filesystem errors shared by implementations and clients. This is a semantic
// contract, not a MyOS wire-code table: Result values cross the process
// boundary with this error payload intact.
export enum FsError {
    Disabled,
    InvalidName,
    AlreadyExists,
    NoFreeSlot,
    AllocFailed,
    NotFound,
    BadFd(i32),
    WrongType(i32),
    BadWhence(i32),
    Closed(i32),
    InvalidSize(i32),
    IoError,
    InvalidEntry(i32),
}

export enum SeekWhence {
    Set,
    Cur,
    End,
}

export impl Describe for FsError {
    str (borrow Self self) describe() {
        return case *self of {
            FsError::Disabled -> "filesystem not available";
            FsError::InvalidName -> "invalid name";
            FsError::AlreadyExists -> "already exists";
            FsError::NoFreeSlot -> "no free directory entry";
            FsError::AllocFailed -> "disk full";
            FsError::NotFound -> "no such file or directory";
            FsError::BadFd(_) -> "bad file descriptor";
            FsError::WrongType(_) -> "wrong kind of entry";
            FsError::BadWhence(_) -> "invalid seek origin";
            FsError::Closed(_) -> "file is closed";
            FsError::InvalidSize(_) -> "invalid size";
            FsError::IoError -> "disk error";
            FsError::InvalidEntry(_) -> "corrupt directory entry";
        };
    }
}
