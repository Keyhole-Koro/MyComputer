package app_protocol;

// Operations owned by the application host/shell rather than the UI server.
export enum AppOp {
    NONE,
    OPEN,
    CLAIM_KEY,
    MAIN_WINDOW,
    EXIT,
    SHOW_DIALOG,
    HIDE_DIALOG,
}

/** Failure while launching an app or routing a path to an app. */
export enum AppError {
    InvalidIndex(i32),
    NotFound,
    PathTooLong(i32),
    NoOpenHandler,
    NoFreeSlot,
    SpawnFailed,
    InstanceUnavailable,
}

/** Failure while registering an app keyboard shortcut. */
export enum KeyClaimError {
    KeySpecTooLong(i32),
    TableFull,
}
