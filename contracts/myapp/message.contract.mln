package app_transport;

// Shared request/event envelope. Domain-specific operations live in
// ui.contract.mln and lifecycle.contract.mln. Transport implementation is
// deliberately outside the contract.

export enum RequestDomain {
    NONE,
    UI,
    APP,
}

export struct Request {
    i32 domain;
    i32 op;
    i32 owner;
    i32 a0;
    i32 a1;
    i32 a2;
    i32 a3;
    i32 a4;
    i32 a5;
    char *s0;
    char *s1;
    // Optional typed result destination. The gateway replaces this user
    // pointer with a kernel staging buffer and copies result_size bytes back
    // with the reply. This is operation-independent.
    i32 result_out;
    i32 result_size;
};

// All asynchronous notifications delivered to the application runtime.
export struct Event {
    i32 owner;
    i32 id;
    i32 kind;
    i32 arg;
    i32 token;
    // Inline storage gives each dequeued event its own text lifetime. It also
    // keeps a queued OPEN path independent from the shell's scratch buffer.
    char text[64];
};

// Sticky wake reasons used by the application transport. A failed nonblocking
// operation arms its bit before returning; WAIT_NOTIFICATION then consumes the
// bit or blocks, so a producer cannot signal in the check-to-sleep gap.
export enum TransportSignal {
    REQUEST_SPACE = 1,
    REPLY = 2,
    EVENT = 4,
}

export enum EventKind {
    NONE,
    CLICK,
    CHANGE,
    ACTIVATE,
    TIMER,
    KEY,
    CLOSE,
    OPEN,
}
