package myos_syscall;

// User-visible syscall numbers shared by process stubs and the kernel.
export enum Syscall {
    EXIT = 1,
    READ,
    WRITE,
    OPEN,
    CLOSE,
    SEEK,
    SBRK,
    YIELD,
    SPAWN,
    OS_CALL,   // (service, args): an OS service outside the kernel.
    WAIT_NOTIFICATION, // (mask): block until an armed kernel notification arrives.
    THREAD_SPAWN,
    THREAD_EXIT,
    THREAD_JOIN,
    THREAD_SELF,
    FUTEX_WAIT,
    FUTEX_WAKE,
}

/**
 * Notification bits the OS raises for a process's own I/O, for
 * SYS_WAIT_NOTIFICATION. A thread's bits are shared with the app transport's
 * TransportSignal (1, 2, 4), so these start above them. Like those, a service
 * that finds nothing ready arms its bit for the calling thread, so a bit raised
 * between that answer and the wait is not lost.
 */
export enum ProcessSignal {
    STDIN = 8,   // a line reached the process's stdin queue (SYS_READ arms it)
    CHILD = 16,  // a child ended and can be reaped (PROC_EXITED arms it)
}

/**
 * Transport status returned by every syscall that resumes its caller.
 *
 * The interrupt ABI writes this enum to r1. Zero is the only success value;
 * failures are positive, stable wire values. The associated success value or
 * error detail is written to r2, so valid negative application values never
 * collide with failure signalling.
 */
export enum SyscallStatus {
    Ok = 0,
    NoProcess,
    OutOfMemory,
    HeapOverflow,
    BadFileDescriptor,
    UnknownSyscall,
    SpawnFailed,
    UnknownService,
    NoFreeThreadSlot,
    InvalidThreadId,
    JoinSelf,
    AlreadyJoined,
    WouldBlock,
    TimedOut,
    BadAddress,
    ProcessExiting,
    InvalidEntry,
    InvalidStackSize,
}

/**
 * Typed copy of the two-register failure envelope used by stdlib adapters.
 * @property status Non-Ok syscall transport status read from r1.
 * @property payload Status-specific detail read from r2, such as a rejected TID or address.
 */
export struct SyscallFailure {
    SyscallStatus status;
    i32 payload;
};
