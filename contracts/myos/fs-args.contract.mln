package myos_fs_args;

import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { FsError, SeekWhence } from "@contracts/io/fs.contract.mln";
import { OsService, OsCall } from "@contracts/myos/services.contract.mln";

// OS_CALL argument records for the hosted filesystem API.
// Each record is followed by the OsService it travels under. result_out
// points into caller memory and must only be written through the OS
// user-memory helpers.

export struct FsOpenArgs {
    char *path;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsOpenArgs = OsService::FS_OPEN;

export struct FsCreateArgs {
    char *path;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsCreateArgs = OsService::FS_CREATE;

export struct FsMkdirArgs {
    char *path;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsMkdirArgs = OsService::FS_MKDIR;

export struct FsRemoveArgs {
    char *path;
    Result<_, FsError> *result_out;
};
export impl OsCall for FsRemoveArgs = OsService::FS_REMOVE;

export struct FsReadArgs {
    i32 fd;
    char *buffer;
    i32 size;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsReadArgs = OsService::FS_READ;

export struct FsWriteArgs {
    i32 fd;
    char *buffer;
    i32 size;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsWriteArgs = OsService::FS_WRITE;

export struct FsSeekArgs {
    i32 fd;
    i32 offset;
    SeekWhence whence;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsSeekArgs = OsService::FS_SEEK;

export struct FsCloseArgs {
    i32 fd;
};
export impl OsCall for FsCloseArgs = OsService::FS_CLOSE;

export struct FsDirNextArgs {
    char *path;
    i32 start;
    char *name_out;
    i32 name_cap;
    Result<Option<i32>, FsError> *result_out;
};
export impl OsCall for FsDirNextArgs = OsService::FS_DIR_NEXT_AT;

export struct FsEntrySizeArgs {
    i32 entry;
    Result<i32, FsError> *result_out;
};
export impl OsCall for FsEntrySizeArgs = OsService::FS_ENTRY_SIZE;

export struct FsIsDirArgs {
    i32 entry;
    Result<bool, FsError> *result_out;
};
export impl OsCall for FsIsDirArgs = OsService::FS_IS_DIR;
