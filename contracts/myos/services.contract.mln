package os_services;

// MyOS's hosted-program ABI. Client libraries send these service numbers
// through OS_CALL; MyOS implements them. This file defines wire constants
// only -- no kernel, filesystem, UI, or application policy belongs here.

export enum OsService {
    NONE,
    // Application request/event transport.
    REQUEST,        // (Request*) -> 1 queued, 0 if full (retry)
    REPLY,          // (i32 *out) -> 1 with the request result, else 0
    POLL,           // (Event*) -> 1 with an event (inline text), else 0
    // Filesystem. Each service is bound to its Fs*Args record by an
    // `impl OsCall` in myos/fs-args.contract.mln; Result values are written
    // through result_out in caller memory. FS_CLOSE is fire-and-forget.
    FS_OPEN,        // FsOpenArgs<Out>
    FS_CREATE,      // FsCreateArgs<Out>
    FS_READ,        // FsReadArgs<Out>
    FS_WRITE,       // FsWriteArgs<Out>
    FS_SEEK,        // FsSeekArgs<Out>
    FS_CLOSE,       // FsCloseArgs
    FS_REMOVE,      // FsRemoveArgs<Out>
    FS_ENTRY_SIZE,  // FsEntrySizeArgs<Out>
    FS_MKDIR,       // FsMkdirArgs<Out>
    FS_DIR_NEXT_AT, // FsDirNextArgs<Out>
    FS_IS_DIR,      // FsIsDirArgs<Out>
    // Processes. Argument pointers refer to the corresponding Proc*Args
    // records in myos/process-args.contract.mln. Spawn's stdout_node is zero
    // for no TextArea binding; typed results are written through result_out.
    PROC_SPAWN,     // ProcSpawnArgs<Out>
    PROC_BIND,      // ProcBindArgs
    PROC_UNBIND,    // ProcUnbindArgs
    PROC_EXITED,    // ProcExitedArgs<Out>
    PROC_REAP,      // ProcReapArgs<Out>
    PROC_FEED,      // ProcFeedArgs
    // Diagnostics.
    LOG,
};

/**
 * Binds an OS_CALL argument record to the one service that accepts it.
 *
 * Each record is followed by `impl OsCall for Record = OsService::X;`, so a
 * client sends the record's own service number and the provider accepts the
 * record only for that number. The reply type is the record's `result_out`
 * field, not a trait parameter.
 */
export trait OsCall {
    OsService service();
}

// Internal OS_CALL routing failure. The kernel maps it to the common
// SyscallStatus plus r2 payload at the user/kernel ABI boundary.
export enum OsServiceError {
    UnknownService(i32),
}
