package process_types;

import { FsError } from "@contracts/io/fs.contract.mln";
import { LoaderError } from "loader.contract.mln";
import { From } from "@std/core/convert.mln";
import { Describe } from "@std/core/describe.mln";

export enum SpawnFsOperation {
    Open,
    Measure,
    Rewind,
    Read,
}

export struct SpawnFilesystemError {
    SpawnFsOperation operation;
    FsError cause;
};

export struct SpawnReadMismatch {
    i32 expected;
    i32 actual;
};

// Launch adds search/read context, but keeps the filesystem and loader causes
// intact instead of collapsing them into generic status values.
export enum SpawnError {
    NoHandler,
    NotFound,
    Filesystem(SpawnFilesystemError),
    EmptyExecutable,
    ShortRead(SpawnReadMismatch),
    BufferAllocationFailed(i32),
    Loader(LoaderError),
}

// A loader failure is a launch failure that keeps its cause.
export impl From<LoaderError> for SpawnError {
    SpawnError from(LoaderError e) {
        return SpawnError::Loader(e);
    }
}

export impl Describe for SpawnError {
    str (Self self) describe() {
        return case self of {
            SpawnError::NoHandler -> "processes cannot be spawned yet";
            SpawnError::NotFound -> "file not found";
            SpawnError::Filesystem(failure) -> failure.cause.describe();
            SpawnError::EmptyExecutable -> "not an executable";
            SpawnError::ShortRead(_) -> "incomplete executable";
            SpawnError::BufferAllocationFailed(_) -> "out of memory";
            SpawnError::Loader(cause) -> cause.describe();
        };
    }
}
