package process_types;
import { Describe } from "@std/core/describe.mln";

/** A process. It crosses the wire as a word; zero names no process, so an ID
 * that may be absent is an Option<Pid>. */
export newtype Pid = i32;

/** Process termination result stored in the Zombie lifecycle state.
 * Ordinary programs may return any i32 through Code; the kernel uses the
 * reason variants when it terminates a process for a synchronous fault.
 */
export enum ProcessExitStatus {
    Code(i32),            // Arbitrary exit code supplied by the application.
    PageFault,            // The kernel terminated the process after a page fault.
    PrivilegeViolation,   // The kernel terminated the process after a privilege fault.
    IllegalInstruction,   // The kernel terminated the process after an illegal instruction.
}

// Errors returned by process control. A process controls only its own children,
// so InvalidPid also answers a pid naming somebody else's child: to the caller,
// no such child exists. NotExited covers a child the OS is still releasing.
export enum ProcessControlError {
    InvalidPid(Pid),
    NotExited(Pid),
}

/** What PROC_BIND, PROC_UNBIND and PROC_FEED answer with in r2. Their records
 * have no result_out, so this word is how a refusal crosses the boundary.
 */
export enum ProcessControlStatus {
    Accepted,
    Refused,   // The pid names no child of the caller.
}

export impl Describe for ProcessControlError {
    str (Self self) describe() {
        return case self of {
            ProcessControlError::InvalidPid(_) -> "no such process";
            ProcessControlError::NotExited(_) -> "process is still running";
        };
    }
}
